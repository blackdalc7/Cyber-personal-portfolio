# Copy to .env (git-ignored). Real environment variables always win over this file.

# --- LLM triage ---------------------------------------------------------------------
# Leave empty to run fully offline: only the deterministic CMDB checks suppress alerts.
# Set to a key from console.anthropic.com to enable Claude false-positive analysis.
ANTHROPIC_API_KEY=
# anthropic | offline (default: anthropic when ANTHROPIC_API_KEY is set)
TRIAGE_LLM_PROVIDER=
TRIAGE_LLM_MODEL=claude-opus-5-5
# low | medium | high
TRIAGE_LLM_EFFORT=low
TRIAGE_LLM_TIMEOUT_S=60
TRIAGE_LLM_MAX_CALLS_PER_MINUTE=30
TRIAGE_LLM_WORKERS=4
TRIAGE_LLM_FAILURE_THRESHOLD=3
TRIAGE_LLM_COOLDOWN_S=300
# A model verdict alone may suppress a meta-alert only at or above this confidence.
TRIAGE_LLM_MIN_CONFIDENCE=0.8

# --- CMDB and clustering ------------------------------------------------------------
TRIAGE_DB_PATH=data/cmdb.sqlite
# dbscan | kmeans
TRIAGE_ALGORITHM=dbscan
# Cosine distance: 0.3 means alerts at least 70% similar are merged.
TRIAGE_DBSCAN_EPS=0.3
# A gap longer than this (seconds) starts a new meta-alert for the same behaviour.
TRIAGE_TIME_WINDOW_S=3600
TRIAGE_KMEANS_MAX_K=60

# --- ROI model (shown in the report as stated assumptions) ----------------------------
TRIAGE_MINUTES_PER_RAW_ALERT=4
TRIAGE_MINUTES_PER_META_ALERT=12
