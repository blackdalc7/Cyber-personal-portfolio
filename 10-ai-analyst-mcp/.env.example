# 10 · AI analyst. Copy to .env (gitignored). In the stack these come from deploy/.env.

# Where the data is. The lake is Watchfloor's Parquet lake (read-only is enough).
ANALYST_LAKE_DIR=../watchfloor/backend/lake
# SQLite CMDB in 06's schema. Build the example one with: python -m ai_analyst build-cmdb
ANALYST_CMDB_PATH=examples/cmdb.sqlite
# Used to build a throwaway CMDB when ANALYST_CMDB_PATH does not exist (default: cmdb_seed.yml next to it)
# ANALYST_CMDB_SEED=examples/cmdb_seed.yml
# Transcripts land here; point the hub's WF_ANALYST_DIR at the same folder.
ANALYST_OUT_DIR=analyst

# offline (rules, no network) | anthropic | ollama
ANALYST_PROVIDER=offline
ANALYST_MODEL=claude-opus-5-5
ANALYST_EFFORT=high                # low | medium | high | xhigh | max
# The Anthropic SDK also finds credentials from `ant auth login`; set a key only if you use one.
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:32b

# Budgets
ANALYST_MAX_TOOL_CALLS=16          # per investigation
ANALYST_MAX_ROWS=100               # per tool result
ANALYST_TIMEOUT_S=300              # per model request
