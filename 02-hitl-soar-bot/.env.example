# Copy to .env (git-ignored). Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Alert intake (required) ---------------------------------------------------
# Senders sign each POST /alerts: X-SOAR-Signature = sha256=HMAC(secret, "<ts>.<body>")
WEBHOOK_SHARED_SECRET=
# Bearer token for GET /incidents, /metrics/mttr, /audit/verify (empty disables them)
SOAR_API_TOKEN=

# --- Listener -------------------------------------------------------------------
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
PUBLIC_BASE_URL=
MAX_BODY_BYTES=262144
SOAR_DATA_DIR=data
# SOAR_DATABASE_PATH=data/soar.db

# --- Slack (interactive buttons) -----------------------------------------------
# Slack app: Bot token scope chat:write; Interactivity Request URL = https://<host>/slack/interactions
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
# Comma-separated Slack user IDs allowed to approve isolation (separation of duties)
SLACK_APPROVER_IDS=

# --- Discord (alternative to Slack) ----------------------------------------------
# Discord app: Interactions Endpoint URL = https://<host>/discord/interactions
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_CHANNEL_ID=
DISCORD_APPROVER_IDS=

# With no Slack/Discord token the bot runs in "outbox" mode: approval cards are written to
# data/outbox and clicks are simulated with scripts/simulate_click.py (signed with
# SLACK_SIGNING_SECRET, approver taken from SLACK_APPROVER_IDS).

# --- Human-in-the-loop policy ---------------------------------------------------
HITL_APPROVAL_TTL_S=3600
HITL_EXPIRY_SWEEP_S=30
# Alerts below this severity are auto-closed without paging anyone
HITL_MIN_SEVERITY=medium

# --- Remediation ------------------------------------------------------------------
# REMEDIATION_SCRIPT=scripts/mock_isolate.py
REMEDIATION_TIMEOUT_S=60
DRY_RUN=false

# --- Enrichment ---------------------------------------------------------------------
ABUSEIPDB_API_KEY=
INTEL_TIMEOUT_S=10

# --- Outbound decision webhook (n8n / Watchfloor automation) ------------------------
# When set, every approve / reject / remediated / failed / expired is POSTed here, signed with
# DECISION_WEBHOOK_SECRET exactly like inbound alerts (X-SOAR-Timestamp, X-SOAR-Signature).
# The secret must be >= 32 chars and different from WEBHOOK_SHARED_SECRET.
DECISION_WEBHOOK_URL=
DECISION_WEBHOOK_SECRET=
