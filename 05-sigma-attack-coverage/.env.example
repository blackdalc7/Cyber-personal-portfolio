# Copy to .env (git-ignored). Real environment variables always win over this file.
# This tool reads only local files and needs no credentials.

# Defaults are relative to the project directory.
COVERAGE_RULES_DIR=rules
COVERAGE_CATALOG=techniques/catalog.yml
COVERAGE_RULE_TESTS_DIR=rule-tests

# Seconds of clock skew tolerated around each exercise step (log source vs. red-team clock).
COVERAGE_SKEW_S=5
