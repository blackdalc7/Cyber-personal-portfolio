# Watchfloor settings (for running outside Docker; deploy/.env.example covers the compose stack).
# Copy to .env (git-ignored). Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Spine ---------------------------------------------------------------------------------------------
WF_REDIS_URL=redis://localhost:6379/0
WF_STREAM=wf:events
WF_DEAD_LETTER_STREAM=wf:dead
# Approximate cap on stream length (older entries are trimmed once the lake has them)
WF_STREAM_MAXLEN=200000

# --- Lake ----------------------------------------------------------------------------------------------
WF_LAKE_DIR=lake
# Flush to Parquet after this many rows or seconds, whichever comes first
WF_FLUSH_ROWS=2000
WF_FLUSH_INTERVAL_S=5

# --- Hub -----------------------------------------------------------------------------------------------
# Bearer token for the read API and dashboard. Empty = no auth: only acceptable on localhost.
WF_HUB_TOKEN=
# Bearer token for POST /api/ingest/{source}. Empty disables the ingest endpoint.
WF_INGEST_TOKEN=
WF_MAX_INGEST_BYTES=5000000
# Comma-separated origins allowed to call the API from another site (empty = same origin only)
WF_CORS_ORIGINS=
# Built dashboard to serve at / (ui/dist after `npm run build`)
WF_UI_DIR=ui/dist
WF_SCENARIOS_DIR=datasets/scenarios

# --- Artefacts the hub serves as-is ---------------------------------------------------------------------
WF_COVERAGE_DIR=../05-sigma-attack-coverage/examples/output
WF_EXPOSURE_FILE=../04-blast-radius-vuln-scanner/examples/output/findings.json
WF_RULES_INDEX=../08-detection-rules/build/rules_index.json
WF_EVIDENCE_DIR=../09-evidence-timeline/examples/output
WF_ANALYST_DIR=../10-ai-analyst-mcp/examples/output

# --- Adapters --------------------------------------------------------------------------------------------
# 01's output directory (events.ndjson, alerts.ndjson, chains.ndjson)
WF_SIEM_DIR=
# 03's alert NDJSON file
WF_EDR_ALERTS=
# 06's queue.json
WF_TRIAGE_QUEUE=../06-alert-clustering-fp-reducer/examples/output/queue.json
# 02's base URL and API token (GET /incidents)
WF_SOAR_URL=
WF_SOAR_TOKEN=
WF_POLL_INTERVAL_S=5
# WF_ADAPTER_STATE=lake/_adapter_state.json

# --- Console actions ---------------------------------------------------------------------------------------
# Lets the dashboard and terminal (/isolate) ask 02 to open an isolation approval card. The hub never
# isolates anything: 02 still needs a signed approval click in Slack or Discord. Requires WF_HUB_TOKEN.
WF_ACTIONS_ENABLED=false
# Same value as 02's WEBHOOK_SHARED_SECRET (the hub signs the request like any other alert sender)
WF_SOAR_WEBHOOK_SECRET=
