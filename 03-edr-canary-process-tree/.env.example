# Copy to .env (git-ignored). Real environment variables always win over this file.
# The EDR canary needs no secrets; every value below is operational configuration.

# Directories that receive canary decoys (semicolon separated).
EDR_WATCH_PATHS=C:\Share\Finance;D:\Projects

# Where alerts.ndjson and forensic snapshots are written.
EDR_OUTPUT_DIR=C:\ProgramData\EdrCanary
EDR_ALERT_MAX_BYTES=10485760
EDR_ALERT_BACKUPS=5

# Suspend the offending process automatically (protected processes are always refused).
EDR_AUTO_CONTAIN=false

# Forward alerts as RFC 5424 syslog to the Project 01 SIEM. Leave empty to disable.
EDR_SIEM_HOST=
EDR_SIEM_PORT=5514

# Kernel ETW consumer.
EDR_TRACEEVENT_PATH=
EDR_INCLUDE_DISK_IO=true
EDR_QUEUE_CAPACITY=50000
