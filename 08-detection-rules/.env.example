# detection-rules settings. Copy to .env (never commit it).

# Where the Watchfloor lake lives (read-only is enough).
RULES_LAKE_DIR=../watchfloor/backend/data/lake
# Where findings go: the hub's OCSF ingest endpoint. REQUIRED for `run` (not for --dry-run).
RULES_HUB_URL=http://127.0.0.1:8000
# REQUIRED for `run`: the hub's WF_INGEST_TOKEN.
RULES_INGEST_TOKEN=
# Watermark and de-duplication state between cycles.
RULES_STATE_FILE=state/state.json
# First run looks back this far; every cycle re-reads this much to catch late-arriving events (seconds).
RULES_LOOKBACK_S=3600
RULES_OVERLAP_S=120
RULES_MAX_FINDINGS_PER_RULE=200
# Optional overrides (default: the folders in this project).
# RULES_RULES_DIR=rules
# RULES_SAMPLES_DIR=samples
# RULES_BUILD_DIR=build
