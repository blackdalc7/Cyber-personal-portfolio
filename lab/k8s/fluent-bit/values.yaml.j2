# Fluent Bit DaemonSet: tail Tetragon's JSON export on the node and POST it to the Watchfloor hub.
# Rendered by Ansible (role fluent_bit_k8s); the token comes from the Secret wf-ingest, never from this file.
kind: DaemonSet
env:
  - name: WF_INGEST_TOKEN
    valueFrom:
      secretKeyRef:
        name: wf-ingest
        key: token
extraVolumes:
  - name: tetragon-export
    hostPath:
      path: /var/run/cilium/tetragon
extraVolumeMounts:
  - name: tetragon-export
    mountPath: /var/run/cilium/tetragon
    readOnly: true
config:
  service: |
    [SERVICE]
        Flush         2
        Log_Level     info
        Parsers_File  /fluent-bit/etc/parsers.conf
        HTTP_Server   On
        HTTP_Listen   0.0.0.0
        HTTP_Port     2020
        storage.path  /tmp/flb-storage
  inputs: |
    [INPUT]
        Name              tail
        Tag               tetragon
        Path              /var/run/cilium/tetragon/tetragon.log
        Parser            json
        DB                /tmp/flb-tetragon.db
        Mem_Buf_Limit     20MB
        Refresh_Interval  5
        storage.type      filesystem
  # Tetragon's export already carries node_name, which the hub maps to device.hostname.
  filters: ""
  outputs: |
    [OUTPUT]
        Name              http
        Match             tetragon
        Host              {{ wf_hub_host }}
        Port              {{ wf_hub_port }}
        URI               /api/ingest/tetragon
        Format            json_lines
        Json_date_key     false
        Header            Authorization Bearer ${WF_INGEST_TOKEN}
        Retry_Limit       10
