# Watchfloor stack settings. Copy to .env (git-ignored) and fill in. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Variables marked REQUIRED stop `docker compose up` with a clear message when empty.

# ---- Spine and hub ----------------------------------------------------------------------------------------
REDIS_PASSWORD=                 # REQUIRED
WF_INGEST_TOKEN=                # REQUIRED: Bearer token for POST /api/ingest/* (Fluent Bit, 08, scripts)
WF_HUB_TOKEN=                   # Bearer token for the read API and the dashboard; empty = no auth (localhost only!)
WF_ACTIONS_ENABLED=false        # true lets the console's /isolate ask 02 for an approval card (needs WF_HUB_TOKEN)
HUB_BIND=127.0.0.1              # set to 192.168.56.1 so lab VMs can ship telemetry to /api/ingest
TZ=UTC

# ---- 01 realtime SIEM (also reads its own settings from this file; see 01's .env.example) ------------------
SYSLOG_BIND=127.0.0.1           # 192.168.56.1 to receive syslog from the lab
SYSLOG_ALLOWED_SOURCES=192.168.56.0/24
LLM_PROVIDER=offline            # anthropic once ANTHROPIC_API_KEY is set
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# ---- 02 HITL SOAR bot (see 02's .env.example for every option) --------------------------------------------
WEBHOOK_SHARED_SECRET=          # REQUIRED by 02: HMAC key for POST /alerts (n8n signs with it)
SOAR_API_TOKEN=                 # Bearer token for 02's read API (the adapters poll /incidents with it)
SOAR_BIND=127.0.0.1
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_APPROVER_IDS=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_CHANNEL_ID=
DISCORD_APPROVER_IDS=
HITL_MIN_SEVERITY=medium
DRY_RUN=true                    # keep true until the remediation script targets your lab only
# Signed decision callback (approve/reject/expire) from 02 to the n8n "decision" workflow.
DECISION_WEBHOOK_URL=http://n8n:5678/webhook/watchfloor-decision
DECISION_WEBHOOK_SECRET=

# ---- n8n (profile: automation) -----------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=             # REQUIRED with the automation profile; keep a copy, n8n cannot decrypt without it
N8N_BIND=127.0.0.1
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false         # true once n8n is behind HTTPS
N8N_MIN_SEVERITY_ID=4           # OCSF severity_id: 4 high, 5 critical
NOTIFY_WEBHOOK_URL=             # Slack incoming webhook or Discord webhook for follow-up notices
ABUSEIPDB_API_KEY=
# N8N_IMAGE=docker.n8n.io/n8nio/n8n:1.121.0

# ---- 09 evidence + Velociraptor (profile: dfir) ------------------------------------------------------------
EVIDENCE_SHARED_SECRET=         # REQUIRED with dfir: HMAC key n8n uses to call POST /collect
EVIDENCE_MODE=velociraptor      # velociraptor | local (parse Hayabusa CSV already on disk)
HAYABUSA_ARTIFACT=Windows.EventLogs.Hayabusa
TRIAGE_ARTIFACTS=Windows.System.Pslist,Windows.Network.Netstat,Windows.Sysinternals.Autoruns
# Pinned server binary. Example (check the releases page for the current one):
#   VELOCIRAPTOR_URL=https://github.com/Velocidex/velociraptor/releases/download/v0.75/velociraptor-v0.75.2-linux-amd64
#   VELOCIRAPTOR_SHA256=<output of: curl -sL "$VELOCIRAPTOR_URL" | sha256sum>
VELOCIRAPTOR_URL=
VELOCIRAPTOR_SHA256=
VELO_PUBLIC_URL=https://192.168.56.1:8100/
VELO_GUI_BIND=127.0.0.1
VELO_FRONTEND_BIND=127.0.0.1    # 192.168.56.1 so lab clients can enrol

# ---- 10 AI analyst (profile: ai) ---------------------------------------------------------------------------
ANALYST_PROVIDER=offline        # anthropic | ollama | offline
ANALYST_MODEL=claude-opus-5-5
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:32b

# ---- Artefact folders the hub shows (defaults are each project's committed example output) -----------------
# EXPOSURE_DIR=../04-blast-radius-vuln-scanner/examples/output
# COVERAGE_05_DIR=../05-sigma-attack-coverage/examples/output
# COVERAGE_07_DIR=../07-attack-emulator/examples/output   # point at ../07-attack-emulator/results for your own runs
# TRIAGE_DIR=../06-alert-clustering-fp-reducer/examples/output
# RULES_DIR=../08-detection-rules/build
# CMDB_DIR=../10-ai-analyst-mcp/examples
