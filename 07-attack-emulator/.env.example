# attack-emulator settings. Copy to .env (never commit it) and fill in the REQUIRED values.

# --- Watchfloor hub (where results are scored) ---
EMU_HUB_URL=http://127.0.0.1:8000
# REQUIRED if the hub sets WF_HUB_TOKEN: read access for /api/findings and /api/events.
EMU_HUB_TOKEN=
# REQUIRED for replay campaigns: the hub's WF_INGEST_TOKEN (replay posts to /api/ingest/ocsf).
EMU_INGEST_TOKEN=

# --- Lab guard rails (live executors refuse anything outside these) ---
# Comma-separated lab networks. Anything wider than /16 (IPv4) or /48 (IPv6) is rejected.
LAB_ALLOWED_CIDRS=192.168.56.0/24
# kubectl contexts that may be used; each must also point at an API server inside LAB_ALLOWED_CIDRS.
LAB_KUBE_CONTEXTS=microk8s

# --- WinRM (Windows lab VM) ---
# REQUIRED for winrm targets. These are throwaway lab credentials; never reuse real ones here.
EMU_WINRM_USER=
EMU_WINRM_PASSWORD=
EMU_WINRM_TRANSPORT=ntlm

# --- SSH (Linux lab VM) ---
EMU_SSH_USER=vagrant
EMU_SSH_KEY=
# Accept unknown host keys. Only for Vagrant VMs whose keys change on every rebuild.
EMU_SSH_TRUST_LAB_HOSTKEYS=false

# --- Scoring ---
# How long to wait for a finding per technique, the backoff base and cap, and the matching window (seconds).
EMU_POLL_TIMEOUT_S=300
EMU_POLL_BASE_S=2
EMU_POLL_MAX_S=30
EMU_WINDOW_S=900
EMU_OUT_DIR=results
