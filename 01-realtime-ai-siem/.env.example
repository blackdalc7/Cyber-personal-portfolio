# Copy to .env and adjust. Never commit .env (it is git-ignored).

# --- UDP syslog listener ------------------------------------------------------
# Unprivileged default port; map 514/udp -> 5514/udp at the firewall or container.
SYSLOG_BIND_HOST=0.0.0.0
SYSLOG_BIND_PORT=5514
# Comma-separated CIDRs allowed to send logs (empty = accept all). UDP sources can be
# spoofed, so treat this as noise reduction and keep the port firewalled too.
SYSLOG_ALLOWED_SOURCES=
SYSLOG_QUEUE_MAX=10000
# Zone used for RFC 3164 timestamps, which carry no zone or year.
SYSLOG_DEFAULT_TZ=UTC

# --- Storage: logging.handlers.RotatingFileHandler -----------------------------
SIEM_OUTPUT_DIR=data
SIEM_ROTATE_MAX_BYTES=52428800
SIEM_ROTATE_BACKUP_COUNT=10
SIEM_STATS_INTERVAL_S=60

# --- Detection tuning ----------------------------------------------------------
DETECT_BRUTE_FORCE_THRESHOLD=10
DETECT_BRUTE_FORCE_WINDOW_S=900
DETECT_SPRAY_USER_THRESHOLD=5
DETECT_SPRAY_WINDOW_S=900
DETECT_POST_COMPROMISE_WINDOW_S=3600
DETECT_ALERT_COOLDOWN_S=300
DETECT_MAX_TRACKED_KEYS=100000

# --- Alert-chain correlation ---------------------------------------------------
CHAIN_WINDOW_S=3600
CHAIN_MIN_ALERTS=2
CHAIN_RESUMMARIZE_S=120

# --- LLM summarisation (Anthropic Claude) --------------------------------------
# anthropic | offline. If unset: anthropic when ANTHROPIC_API_KEY is set, else offline.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_TIMEOUT_S=60
LLM_MAX_CALLS_PER_MINUTE=6
# Pseudonymise usernames and hostnames before they leave the network.
LLM_REDACT=false
LLM_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_S=300
