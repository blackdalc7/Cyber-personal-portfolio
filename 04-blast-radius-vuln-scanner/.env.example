# Copy to .env (git-ignored). Real environment variables always win over this file.

# Free key from https://nvd.nist.gov/developers/request-an-api-key
# Raises the NVD rate limit from 5 to 50 requests per 30 seconds.
NVD_API_KEY=

# Feed endpoints (override for a mirror or proxy).
# NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# EPSS_API_URL=https://api.first.org/data/v1/epss
# KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

VULN_HTTP_TIMEOUT_S=30
VULN_CACHE_PATH=.cache/vuln_scanner.sqlite
VULN_CACHE_TTL_S=86400
VULN_OFFLINE=false

# Scoring policy
VULN_KEV_FLOOR=0.7                 # likelihood floor for CVEs in CISA KEV
VULN_EXPLOITABLE_THRESHOLD=0.1     # likelihood at which a service is a pivot in the attack graph
VULN_MAX_HOPS=4
VULN_HOP_DECAY=0.5
