# evidence-timeline settings. Copy to .env (never commit it).

# REQUIRED for `serve`: HMAC key n8n signs /collect requests with (>= 32 chars). Same scheme as 02's alerts.
EVIDENCE_SHARED_SECRET=
EVIDENCE_LISTEN_HOST=127.0.0.1
EVIDENCE_LISTEN_PORT=8090
EVIDENCE_OUT_DIR=evidence

# velociraptor: collect from the endpoint through the Velociraptor server API.
# local: read a Hayabusa CSV timeline already on disk at EVIDENCE_LOCAL_DIR/<host>.csv (demo, or offline triage).
EVIDENCE_MODE=velociraptor
EVIDENCE_LOCAL_DIR=examples/hayabusa

# The api_client config the Velociraptor server writes (deploy/velociraptor puts it in the velo-data volume).
VELOCIRAPTOR_API_CONFIG=api.config.yaml
# Artifacts must be on the read-only triage allowlist (EventLogs, System, Network, Autoruns, Forensics...).
HAYABUSA_ARTIFACT=Windows.EventLogs.Hayabusa
TRIAGE_ARTIFACTS=Windows.System.Pslist,Windows.Network.Netstat,Windows.Sysinternals.Autoruns
EVIDENCE_COLLECT_TIMEOUT_S=1800

# Watchfloor telemetry merged into the timeline (optional).
EVIDENCE_HUB_URL=http://127.0.0.1:8000
EVIDENCE_HUB_TOKEN=
EVIDENCE_WINDOW_BEFORE_S=3600
EVIDENCE_WINDOW_AFTER_S=1800
EVIDENCE_MAX_ROWS=50000
